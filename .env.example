# Copy to .env and fill in real values. NEVER commit .env.
# Spec 001 introduces these; later specs append their own (auth in 002,
# the AI model host in 010).

# local | staging | prod
ENVIRONMENT=local

# Overwritten at build time with the git sha; "dev" locally.
APP_VERSION=dev

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Driver-neutral. The app adapts the scheme to asyncpg, Alembic to psycopg.
DATABASE_URL=postgresql://ctf:ctf_local_dev@localhost:15432/ctf

REDIS_URL=redis://localhost:6379/0

# Comma-separated. Only used when the frontend is served from another origin;
# local dev goes through the Vite proxy and never hits this.
CORS_ALLOWED_ORIGINS=http://localhost:4173

# --- Sessions (spec 002) -----------------------------------------------------
# Signs access tokens. Rotating it ends every live session. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
# Turn off ONLY for a local plain-HTTP dev server.
COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:4173

# --- Entra ID (spec 002) -----------------------------------------------------
# Sign-in is tenant-wide: any employee in the tenant may log in.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/entra/callback
# Comma-separated corporate domains that must use the work-account button
# rather than a magic link. Kept in config so the list never enters source.
ENTRA_ENFORCED_EMAIL_DOMAINS=

# --- Outbound mail (spec 002) ------------------------------------------------
# Proton Mail SMTP. SMTP_TOKEN is the Proton SMTP submission token, not a
# mailbox password. Never commit a real value.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=admin@ctf-nm.org
SMTP_TOKEN=
SMTP_FROM=admin@ctf-nm.org
SMTP_USE_TLS=true

# --- Artifact storage (spec 003) ---------------------------------------------
# MinIO in-cluster, S3-compatible. Any number of API replicas share one store,
# so no ReadWriteMany volume is needed.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ctf-artifacts
S3_ACCESS_KEY=ctf_minio
S3_SECRET_KEY=ctf_minio_local_dev
S3_REGION=us-east-1
