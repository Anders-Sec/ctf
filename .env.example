# Copy to .env and fill in real values. NEVER commit .env.
# Spec 001 introduces these; later specs append their own (auth in 002,
# the AI model host in 010).

# local | staging | prod
ENVIRONMENT=local

# Overwritten at build time with the git sha; "dev" locally.
APP_VERSION=dev

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Driver-neutral. The app adapts the scheme to asyncpg, Alembic to psycopg.
DATABASE_URL=postgresql://ctf:ctf_local_dev@localhost:15432/ctf

REDIS_URL=redis://localhost:6379/0

# Comma-separated. Only used when the frontend is served from another origin;
# local dev goes through the Vite proxy and never hits this.
CORS_ALLOWED_ORIGINS=http://localhost:5173
